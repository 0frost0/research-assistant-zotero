# Merge these settings into the existing project .env; do not replace it.
# Existing OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL are reused if the
# corresponding TRANSLATION_* setting is absent. Never commit real secrets.
RESEARCH_TRANSLATION_ENABLED=true
# TRANSLATION_API_KEY=replace-with-your-key
# TRANSLATION_MODEL=deepseek-chat
# TRANSLATION_BASE_URL=https://api.deepseek.com/v1
# RESEARCH_TRANSLATION_PYTHON=D:/workspace/research_assistant/.translation_env/Scripts/python.exe
RESEARCH_TRANSLATION_TIMEOUT=1800
# Adapter v3 retains max 4 workers / QPS 2, 90s per request and at most 3 attempts.
# All full-PDF SDK requests reserve a SQLite budget first; output cap is 2048.
# Per-document limits are set in /reader (default 20000 tokens / 20 requests).
# Full-PDF daily limits: 50000 reserved/accounted tokens and 50 requests.
# These limits do not include selection translation or other application calls.
# Official DeepSeek v4 uses explicit non-thinking mode and a free balance precheck.
# Policy is versioned in research_assistant/translation/policy.py, not secret config.
# The automatic-upload switch is persisted in reading.sqlite3, set in /reader.
# Auto full-PDF translation defaults OFF; explicitly saved preferences are kept.
# Selected-text translation reuses TRANSLATION_*/OPENAI_* without BabelDOC.
# It makes one request with no retry; limits apply only to this text path.
